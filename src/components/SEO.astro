---
import { siteMetadata } from "../site";
import type { SEOProps } from "../types";
import defaultImage from "../content/images/logo.png";
import {
  personSchema,
  websiteSchema,
  articleSchema,
  breadcrumbSchema,
  graphDoc,
} from "../lib/schema";

const { title, description, pathname, image, keywords, article, datePublished, markdown } =
  Astro.props as SEOProps;

const {
  title: defaultTitle,
  name: authorName,
  jobTitle,
  description: defaultDescription,
  siteUrl,
  twitterUsername,
  keywords: defaultKeywords,
} = siteMetadata;

/* Pages are built as directories, so the server actually serves (and the
   sitemap lists) the trailing-slash URL — "/sheetboard" 301s to
   "/sheetboard/". The canonical must be the served URL, not the redirect,
   or Google reports "duplicate, chose a different canonical". */
const canonicalPath = (pathname || "").replace(/^\/+|\/+$/g, "");
const seo = {
  title: title || `${authorName} — ${jobTitle}`,
  description: description || defaultDescription,
  image: `${siteUrl}${image || defaultImage.src}`,
  url: canonicalPath ? `${siteUrl}/${canonicalPath}/` : `${siteUrl}/`,
  keywords: keywords || defaultKeywords,
};

const graph: object[] = [personSchema(`${siteUrl}${defaultImage.src}`), websiteSchema()];
if (article) {
  graph.push(
    articleSchema({
      title: seo.title,
      description: seo.description,
      image: seo.image,
      url: seo.url,
      datePublished,
      keywords: seo.keywords,
    }),
    breadcrumbSchema(title || seo.title, seo.url),
  );
}
const jsonLd = graphDoc(graph);
---

<title>{seo.title}</title>
<meta name="title" content={seo.title} />
<meta name="description" content={seo.description} />
<meta name="keywords" content={seo.keywords} />
<meta name="image" content={seo.image} />
<meta name="revisit-after" content="15 days" />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="language" content="English" />
<meta name="author" content={authorName} />
<link rel="canonical" href={seo.url} />
{
  markdown && (
    <link
      rel="alternate"
      type="text/markdown"
      href={`${siteUrl}${markdown}`}
      title={`${seo.title} (markdown)`}
    />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:url" content={seo.url} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.image} />
<meta name="twitter:image:alt" content={seo.title} />
<meta name="twitter:creator" content={twitterUsername} />

<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:image" content={seo.image} />
<meta property="og:image:alt" content={seo.title} />
<meta property="og:url" content={seo.url} />
<meta property="og:site_name" content={defaultTitle} />
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:locale" content="en_US" />
{article && datePublished && <meta property="article:published_time" content={datePublished} />}
{article && datePublished && <meta property="article:modified_time" content={datePublished} />}
{article && <meta property="article:author" content={authorName} />}

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
