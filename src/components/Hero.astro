---
import { siteMetadata } from "../site";

interface Props {
  projectCount: number;
}
const { projectCount } = Astro.props;
const years = new Date().getFullYear() - 2019;

/* ------------------------------------------------------------------
   Tiny token model → syntax-highlighted HTML for the code panel.
   Rendered to a string and injected with set:html, so the matching
   styles MUST live in the global <style> block below — Astro's scope
   hash never reaches runtime-injected DOM (set:html / innerHTML).
   ------------------------------------------------------------------ */
interface Tok {
  c: string;
  t: string;
  href?: string;
  ext?: boolean;
}
const k = (t: string): Tok => ({ c: "t-kw", t });
const ty = (t: string): Tok => ({ c: "t-type", t });
const pr = (t: string): Tok => ({ c: "t-prop", t });
const s = (t: string): Tok => ({ c: "t-str", t });
const nu = (t: string): Tok => ({ c: "t-num", t });
const fn = (t: string): Tok => ({ c: "t-fn", t });
const p = (t: string): Tok => ({ c: "t-punc", t });
const co = (t: string): Tok => ({ c: "t-com", t });
const x = (t: string): Tok => ({ c: "", t });
const ct = (t: string, href: string, ext = true): Tok => ({ c: "t-str", t, href, ext });

const esc = (str: string): string =>
  str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const renderTok = (tk: Tok): string => {
  const text = esc(tk.t);
  if (tk.href !== undefined) {
    const attrs = tk.ext ? ' target="_blank" rel="noopener"' : "";
    return `<a class="${tk.c} cw-link" href="${esc(tk.href)}"${attrs}>${text}</a>`;
  }
  return tk.c ? `<span class="${tk.c}">${text}</span>` : text;
};

const renderPane = (lines: Tok[][]): string =>
  lines
    .map((toks, i) => {
      const last = i === lines.length - 1;
      const inner = toks.map(renderTok).join("") + (last ? '<span class="cw-caret"></span>' : "");
      return `<span class="cw-line"><span class="cw-ln">${i + 1}</span><span class="cw-code">${inner}</span></span>`;
    })
    .join("");

const engineer: Tok[][] = [
  [k("type"), x(" "), ty("Domain"), x(" "), p("="), x(" "), s('"Full-Stack"'), x(" "), p("|"), x(" "), s('"Cloud"'), x(" "), p("|"), x(" "), s('"Gen AI"'), p(";")],
  [],
  [k("class"), x(" "), ty("Engineer"), x(" "), p("{")],
  [x("  "), pr("name"), x("  "), p("="), x(" "), s('"Keshav Lingala"'), p(";")],
  [x("  "), pr("title"), x(" "), p("="), x(" "), s('"Senior Software Engineer"'), p(";")],
  [x("  "), pr("since"), x(" "), p("="), x(" "), nu("2019"), p(";"), x("          "), co(`// ${years} yrs · ${projectCount} shipped`)],
  [],
  [x("  "), pr("fullStack"), x(" "), p("= ["), s('"Angular"'), p(","), x(" "), s('"Spring Boot"'), p(","), x(" "), s('"SQL"'), p("];")],
  [x("  "), pr("cloud"), x("     "), p("= ["), s('"AWS"'), p(","), x(" "), s('"Kubernetes"'), p(","), x(" "), s('"Docker"'), p("];")],
  [x("  "), pr("genAI"), x("     "), p("= ["), s('"LangChain"'), p(","), x(" "), s('"RAG"'), p(","), x(" "), s('"Agents"'), p("];")],
  [],
  [x("  "), fn("build"), p("("), x("idea"), p(":"), x(" "), ty("Idea"), p("):"), x(" "), ty("Product"), x(" "), p("{")],
  [x("    "), k("return"), x(" "), fn("ship"), p("("), k("this"), p("."), fn("code"), p("("), x("idea"), p("));")],
  [x("  "), p("}")],
  [p("}")],
];

const skills: Tok[][] = [
  [p("{")],
  [x("  "), pr('"languages"'), p(":"), x(" "), p("["), s('"TypeScript"'), p(","), x(" "), s('"Java"'), p(","), x(" "), s('"Go"'), p(","), x(" "), s('"Python"'), p("],")],
  [x("  "), pr('"frontend"'), p(":"), x("  "), p("["), s('"Angular"'), p(","), x(" "), s('"React"'), p(","), x(" "), s('"GraphQL"'), p("],")],
  [x("  "), pr('"backend"'), p(":"), x("   "), p("["), s('"Spring Boot"'), p(","), x(" "), s('"Node.js"'), p(","), x(" "), s('"NestJS"'), p("],")],
  [x("  "), pr('"cloud"'), p(":"), x("     "), p("["), s('"AWS"'), p(","), x(" "), s('"Docker"'), p(","), x(" "), s('"Kubernetes"'), p(","), x(" "), s('"Kafka"'), p("],")],
  [x("  "), pr('"genAI"'), p(":"), x("     "), p("["), s('"LangChain"'), p(","), x(" "), s('"RAG"'), p(","), x(" "), s('"Agents"'), p(","), x(" "), s('"Ollama"'), p("],")],
  [x("  "), pr('"shipped"'), p(":"), x("   "), nu(String(projectCount))],
  [p("}")],
];

const contact: Tok[][] = [
  [k("const"), x(" "), x("reach"), x(" "), p("="), x(" "), p("{")],
  [x("  "), pr("email"), p(":"), x("    "), ct('"admin@keshav.codes"', `mailto:${siteMetadata.email}`, false), p(",")],
  [x("  "), pr("github"), p(":"), x("   "), ct('"keshavlingala"', siteMetadata.github), p(",")],
  [x("  "), pr("linkedin"), p(":"), x(" "), ct('"keshavlingala"', siteMetadata.linkedin), p(",")],
  [x("  "), pr("status"), p(":"), x("   "), s('"open to opportunities"'), p(",")],
  [p("};")],
  [],
  [k("export"), x(" "), k("const"), x(" "), fn("say"), x(" "), p("="), x(" "), p("("), x("msg"), p(":"), x(" "), ty("string"), p(")"), x(" "), p("=>")],
  [x("  "), fn("fetch"), p("("), s('"/contact"'), p(","), x(" "), p("{"), x(" "), pr("method"), p(":"), x(" "), s('"POST"'), p(","), x(" "), pr("body"), p(":"), x(" "), x("msg"), x(" "), p("});")],
];

const files = [
  { name: "engineer.ts", body: renderPane(engineer) },
  { name: "skills.json", body: renderPane(skills) },
  { name: "contact.ts", body: renderPane(contact) },
];
---

<section id="top" class="hero wrap">
  <div class="hero-left">
    <p class="hero-status"><i class="live" aria-hidden="true"></i> Senior Software Engineer</p>
    <h1 class="hero-name">Keshav<br /><span class="accent">Lingala</span></h1>
    <p class="hero-role">MS in Computer Science · Based in Dayton, OH</p>
    <p class="hero-tag">
      Full-stack engineer building systems that scale — from Angular and React interfaces down to
      Spring&nbsp;Boot and Node services on AWS and Kubernetes. Seven years across banking,
      big-data and distribution.
    </p>
    <div class="hero-cta">
      <a class="cta-go" href="#work">
        <span class="cta-go-lbl">View my work</span>
        <span class="cta-go-arr" aria-hidden="true">
          <svg width="46" height="12" viewBox="0 0 46 12" fill="none">
            <line
              class="cta-ln"
              x1="0"
              y1="6"
              x2="28"
              y2="6"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></line>
            <path
              class="cta-hd"
              d="M25 1.5 L31 6 L25 10.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </a>
      <span class="cta-sep" aria-hidden="true"></span>
      <a class="cta-alt" href="#contact">Get in touch</a>
    </div>
    <div class="hero-meta">
      <div class="stat">
        <span class="stat-num">{years}</span><span class="stat-lbl">Years experience</span>
      </div>
      <div class="stat">
        <span class="stat-num">{projectCount}</span><span class="stat-lbl">Shipped projects</span>
      </div>
      <div class="stat">
        <span class="stat-num">60+</span><span class="stat-lbl">Technologies</span>
      </div>
    </div>
  </div>

  <div class="hero-right">
    <div class="codewin" role="group" aria-label="Code panel — switch files and run">
      <div class="codewin-bar">
        <span class="cw-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="cw-tabs" role="tablist" aria-label="Code files">
          {
            files.map((f, i) => (
              <button
                class={"cw-tab" + (i === 0 ? " on" : "")}
                role="tab"
                type="button"
                data-file={f.name}
                aria-selected={i === 0 ? "true" : "false"}
              >
                {f.name}
              </button>
            ))
          }
        </div>
        <button class="cw-run" type="button" aria-label="Run active file">
          <svg class="cw-play" viewBox="0 0 10 11" width="9" height="10" aria-hidden="true">
            <path d="M1 1 L9 5.5 L1 10 Z" fill="currentColor"></path>
          </svg>
          <span class="cw-spin" aria-hidden="true"></span>
          <span class="cw-run-lbl">Run</span>
        </button>
      </div>

      <div class="codewin-main">
        {
          files.map((f, i) => (
            <pre class="codewin-body cw-pane" data-file={f.name} hidden={i !== 0}><code set:html={f.body}></code></pre>
          ))
        }
        <div class="cw-console" hidden aria-live="polite"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 40px;
    align-items: center;
    padding: 86px 32px 72px;
    min-height: 84vh;
    scroll-margin-top: 0;
  }
  .hero-status {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-2);
    display: flex;
    align-items: center;
    gap: 9px;
    letter-spacing: 0.03em;
    margin: 0;
  }
  .hero-status .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #5fd08a;
    animation: livePulse 2.2s infinite;
  }
  .hero-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(46px, 7.4vw, 90px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin: 18px 0 0;
  }
  .hero-role {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text-2);
    margin: 16px 0 0;
    letter-spacing: 0.02em;
  }
  .hero-tag {
    color: var(--text-3);
    font-size: 16px;
    line-height: 1.62;
    max-width: 50ch;
    margin: 22px 0 0;
    text-wrap: pretty;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-top: 34px;
    flex-wrap: wrap;
  }
  .cta-go {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.015em;
  }
  .cta-go-lbl {
    position: relative;
    padding-bottom: 5px;
  }
  .cta-go-lbl::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--amber-bright), var(--amber-deep));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.42s var(--ease);
  }
  .cta-go:hover .cta-go-lbl::after {
    transform: scaleX(1);
  }
  .cta-go-arr {
    display: inline-flex;
    color: var(--amber);
  }
  .cta-go:hover {
    color: var(--amber-bright);
  }
  .cta-ln {
    transition: transform 0.35s var(--ease);
    transform-origin: left center;
  }
  .cta-hd {
    transition: transform 0.35s var(--ease);
  }
  .cta-go:hover .cta-ln {
    transform: scaleX(1.45);
  }
  .cta-go:hover .cta-hd {
    transform: translateX(11px);
  }
  .cta-sep {
    width: 1px;
    height: 24px;
    background: var(--line-2);
  }
  .cta-alt {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--text-3);
    text-decoration: none;
    position: relative;
    padding-bottom: 3px;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .cta-alt::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--text-4);
    transition: background 0.2s;
  }
  .cta-alt:hover {
    color: var(--text);
  }
  .cta-alt:hover::after {
    background: var(--amber);
  }
  .hero-meta {
    display: flex;
    flex-wrap: nowrap;
    gap: 0;
    margin-top: 40px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
    width: fit-content;
  }
  .hero-meta .stat {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 0 20px;
    border-right: 1px solid var(--line);
  }
  .hero-meta .stat:first-child {
    padding-left: 0;
  }
  .hero-meta .stat:last-child {
    border-right: 0;
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .stat-lbl {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-4);
    white-space: nowrap;
  }

  /* code panel chrome (these elements exist at compile time → scoped) */
  .hero-right {
    display: grid;
    place-items: center;
    perspective: 1100px;
  }
  .codewin {
    width: 100%;
    max-width: 472px;
    margin-left: auto;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(155deg, rgba(46, 39, 32, 0.66), rgba(26, 21, 18, 0.5));
    border: 1px solid var(--glass-brd);
    -webkit-backdrop-filter: blur(18px) saturate(1.25);
    backdrop-filter: blur(18px) saturate(1.25);
    box-shadow:
      0 34px 80px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .codewin-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.025);
  }
  .cw-dots {
    display: flex;
    gap: 7px;
    flex: 0 0 auto;
  }
  .cw-dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg-3);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }
  .cw-dots i:first-child {
    background: rgba(230, 180, 120, 0.55);
    border-color: transparent;
  }

  /* tabs */
  .cw-tabs {
    display: flex;
    gap: 2px;
    margin-right: auto;
    overflow: hidden;
  }
  .cw-tab {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-4);
    background: transparent;
    border: 0;
    border-radius: 7px;
    padding: 4px 9px;
    cursor: pointer;
    white-space: nowrap;
    transition: 0.18s var(--ease);
  }
  .cw-tab:hover {
    color: var(--text-2);
    background: rgba(255, 255, 255, 0.045);
  }
  .cw-tab.on {
    color: var(--amber-bright);
    background: rgba(230, 180, 120, 0.12);
  }
  .cw-tab:focus-visible {
    outline: 1px solid var(--amber-deep);
    outline-offset: 1px;
  }

  /* run button */
  .cw-run {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--amber);
    background: rgba(230, 180, 120, 0.08);
    border: 1px solid rgba(230, 180, 120, 0.28);
    border-radius: 6px;
    padding: 3px 9px 3px 8px;
    cursor: pointer;
    transition: 0.18s var(--ease);
  }
  .cw-run:hover {
    color: var(--amber-bright);
    background: rgba(230, 180, 120, 0.16);
    border-color: rgba(230, 180, 120, 0.5);
  }
  .cw-run:focus-visible {
    outline: 1px solid var(--amber-deep);
    outline-offset: 1px;
  }
  .cw-play {
    display: block;
  }
  .cw-spin {
    display: none;
    width: 9px;
    height: 9px;
    border: 1.5px solid rgba(230, 180, 120, 0.35);
    border-top-color: var(--amber);
    border-radius: 50%;
  }
  .cw-run.running {
    pointer-events: none;
  }
  .cw-run.running .cw-play {
    display: none;
  }
  .cw-run.running .cw-spin {
    display: inline-block;
    animation: spin 0.6s linear infinite;
  }

  .codewin-main {
    position: relative;
  }
  .codewin-body {
    margin: 0;
    padding: 16px 18px 18px;
    overflow-x: auto;
    /* lines break via .cw-line (flex); avoid extra blank rows from
       newline text nodes between rows in the source */
    white-space: normal;
  }
  .codewin-body code {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.85;
    display: block;
  }
  .cw-console {
    border-top: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.28);
    padding: 10px 18px 13px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    animation: paneIn 0.3s var(--ease);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 920px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: 64px;
      gap: 30px;
    }
    .hero-right {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-status .live,
    .cw-run.running .cw-spin {
      animation: none;
    }
    .cw-console {
      animation: none;
    }
    .cta-ln,
    .cta-hd,
    .cta-go-lbl::after {
      transition: none;
    }
  }
</style>

<!-- Code-panel CONTENT is injected via set:html / innerHTML, so its styles
     must be global (Astro's scope hash never reaches runtime-injected DOM).
     Namespaced under .codewin / .cw-console to avoid leaking. -->
<style is:global>
  .codewin .cw-line {
    display: flex;
    gap: 18px;
    white-space: pre;
  }
  .codewin .cw-ln {
    min-width: 16px;
    text-align: right;
    color: var(--text-4);
    user-select: none;
    flex: 0 0 auto;
  }
  .codewin .cw-code {
    color: var(--text-2);
    white-space: pre;
  }
  .codewin .t-kw {
    color: #d08a86;
  }
  .codewin .t-type {
    color: var(--teal-bright);
  }
  .codewin .t-prop {
    color: var(--amber-bright);
  }
  .codewin .t-str {
    color: #cbb389;
  }
  .codewin .t-num {
    color: #e0c98f;
  }
  .codewin .t-bool {
    color: #d08a86;
  }
  .codewin .t-fn {
    color: #8bb8c7;
  }
  .codewin .t-punc {
    color: var(--text-4);
  }
  .codewin .t-com {
    color: var(--text-4);
    font-style: italic;
  }
  .codewin .cw-link {
    text-decoration: none;
    border-bottom: 1px dashed rgba(203, 179, 137, 0.5);
    cursor: pointer;
    transition: color 0.15s;
  }
  .codewin .cw-link:hover {
    color: var(--amber-bright);
    border-bottom-color: var(--amber);
  }
  .codewin .cw-caret {
    display: inline-block;
    width: 7px;
    height: 15px;
    background: var(--amber);
    margin-left: 3px;
    vertical-align: -2px;
    animation: caretBlink 1.1s steps(1) infinite;
  }

  /* console / REPL output */
  .cw-console .cw-out-line {
    white-space: pre-wrap;
    opacity: 0;
    animation: cwOut 0.28s var(--ease) forwards;
  }
  .cw-console .cw-out-line:nth-child(1) {
    animation-delay: 0.02s;
  }
  .cw-console .cw-out-line:nth-child(2) {
    animation-delay: 0.18s;
  }
  .cw-console .cw-in {
    color: var(--text-3);
  }
  .cw-console .cw-ok {
    color: #7fd39a;
  }
  .cw-console a {
    color: var(--amber);
    text-decoration: none;
    border-bottom: 1px solid var(--amber-deep);
  }
  .cw-console a:hover {
    color: var(--amber-bright);
  }

  @keyframes cwOut {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .codewin .cw-caret {
      animation: none;
    }
    .cw-console .cw-out-line {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  const win = document.querySelector<HTMLElement>(".codewin");
  if (win) {
    const heroRight = win.closest<HTMLElement>(".hero-right")!;
    const tabs = [...win.querySelectorAll<HTMLButtonElement>(".cw-tab")];
    const panes = [...win.querySelectorAll<HTMLElement>(".cw-pane")];
    const runBtn = win.querySelector<HTMLButtonElement>(".cw-run")!;
    const runLbl = win.querySelector<HTMLElement>(".cw-run-lbl")!;
    const consoleEl = win.querySelector<HTMLElement>(".cw-console")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Per-file REPL output revealed by Run.
    const runOut: Record<string, string> = {
      "engineer.ts": `<span class="cw-out-line cw-in">&gt; new Engineer().build(idea)</span><span class="cw-out-line cw-ok">✓ shipped in 0.42s — <a href="#work">view 16 projects →</a></span>`,
      "skills.json": `<span class="cw-out-line cw-in">&gt; Object.values(skills).flat().length</span><span class="cw-out-line cw-ok">→ 60+ technologies — <a href="#skills">open the galaxy →</a></span>`,
      "contact.ts": `<span class="cw-out-line cw-in">&gt; say("let's build something")</span><span class="cw-out-line cw-ok">✓ 202 Accepted — <a href="#contact">open channel →</a></span>`,
    };

    const activeFile = () =>
      tabs.find((t) => t.classList.contains("on"))?.dataset.file ?? tabs[0].dataset.file!;

    const closeConsole = () => {
      consoleEl.hidden = true;
      consoleEl.replaceChildren();
    };

    // ── file tabs ─────────────────────────────────────────────────
    const activate = (file: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.file === file;
        t.classList.toggle("on", on);
        t.setAttribute("aria-selected", String(on));
      });
      panes.forEach((p) => (p.hidden = p.dataset.file !== file));
      closeConsole();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activate(tab.dataset.file!));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const next = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        activate(next.dataset.file!);
      });
    });

    // ── Run → console output ──────────────────────────────────────
    let running = false;
    runBtn.addEventListener("click", () => {
      if (running) return;
      const out = runOut[activeFile()];
      if (!out) return;
      running = true;
      runBtn.classList.add("running");
      runLbl.textContent = "Running";
      window.setTimeout(
        () => {
          consoleEl.innerHTML = out;
          consoleEl.hidden = false;
          runBtn.classList.remove("running");
          runLbl.textContent = "Run";
          running = false;
        },
        reduce ? 0 : 420,
      );
    });

    // ── cursor parallax tilt (fine pointers, motion allowed) ──────
    if (matchMedia("(pointer: fine)").matches && !reduce) {
      heroRight.addEventListener("pointermove", (e) => {
        const r = heroRight.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        win.style.transition = "transform 0.08s linear";
        win.style.transform = `rotateY(${px * 6}deg) rotateX(${-py * 6}deg)`;
      });
      heroRight.addEventListener("pointerleave", () => {
        win.style.transition = "transform 0.6s var(--ease)";
        win.style.transform = "";
      });
    }
  }
</script>
